{
  "name": "test-jest-comment-coverage-diff",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "nyc --reporter=json-summary --reporter=text mocha test/**/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aviralpostman/test-jest-comment-coverage-diff.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aviralpostman/test-jest-comment-coverage-diff/issues"
  },
  "homepage": "https://github.com/aviralpostman/test-jest-comment-coverage-diff#readme",
  "devDependencies": {
    "chai": "^4.2.0",
    "mocha": "^8.4.0",
    "mocha-json-summary": "^0.1.1",
    "nyc": "^15.1.0"
  },
  "nyc": {
    "all": true,
    "include": [
      "src/**/*.js"
    ],
    "exclude": [
      "test/**/*.js"
    ],
    "reporter": [
      "json-summary",
      "text"
    ],
    "check-coverage": true,
    "branches": 80,
    "lines": 80,
    "functions": 80,
    "statements": 80
  }
}
